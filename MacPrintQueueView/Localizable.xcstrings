          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge görüntülenemiyor."
          }
        }
      }
    },
    "The document contains no pages to show.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het document bevat geen pagina’s om te tonen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belgede gösterilecek sayfa yok."
          }
        }
      }
    },
    "The document is empty.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het document is leeg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge boş."
          }
        }
      }
    },
    "The document is no longer available in the queue.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het document is niet meer beschikbaar in de wachtrij."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge artık kuyrukta mevcut değil."
          }
        }
      }
    },
    "The job could not be deleted.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taak kan niet worden verwijderd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş silinemedi."
          }
        }
      }
    },
    "The job could not be paused.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taak kan niet worden gepauzeerd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş duraklatılamadı."
          }
        }
      }
    },
    "The job could not be put back in the queue. The document may already have been removed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taak kan niet opnieuw in de wachtrij worden gezet. Mogelijk is het document al opgeruimd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş yeniden kuyruğa alınamadı. Belge zaten kaldırılmış olabilir."
          }
        }
      }
    },
    "The job could not be removed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taak kan niet worden opgeruimd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş kaldırılamadı."
          }
        }
      }
    },
    "The job could not be resumed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taak kan niet worden hervat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş sürdürülemedi."
          }
        }
      }
    },
    "The job will be put back in the queue and printed again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taak wordt opnieuw in de wachtrij gezet en nog een keer afgedrukt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş yeniden kuyruğa alınacak ve tekrar yazdırılacak."
          }
        }
      }
    },
    "The printing service returned an error.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afdrukservice gaf een fout."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdırma hizmeti bir hata döndürdü."
          }
        }
      }
    },
    "The queue order could not be changed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgorde van de wachtrij kan niet worden aangepast."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruk sırası değiştirilemedi."
          }
        }
      }
    },
    "The selected jobs will be canceled right away. They move to “Completed”, where you can print them again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde taken worden direct geannuleerd. Ze komen bij “Voltooid”, waar je ze opnieuw kunt afdrukken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili işler hemen iptal edilecek. “Tamamlandı” bölümüne taşınacaklar; oradan yeniden yazdırabilirsiniz."
          }
        }
      }
    },
    "This document is PostScript; macOS can no longer render that format itself.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit document is PostScript; dat formaat kan macOS niet meer zelf weergeven."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu belge PostScript biçiminde; macOS bu biçimi artık kendisi görüntüleyemiyor."
          }
        }
      }
    },
    "This job belongs to another user. macOS only gives the owner of a job access to its content.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak is van een andere gebruiker. macOS geeft alleen de eigenaar van een taak toegang tot de inhoud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iş başka bir kullanıcıya ait. macOS bir işin içeriğine yalnızca sahibinin erişmesine izin verir."
          }
        }
      }
    },
    "This job does not contain a document (yet).": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak bevat (nog) geen document."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iş (henüz) bir belge içermiyor."
          }
        }
      }
    },
    "This job has already started printing and can no longer be paused. You can cancel it instead.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze taak wordt al afgedrukt en kan niet meer worden gepauzeerd. Je kunt hem wel annuleren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iş zaten yazdırılmaya başladı ve artık duraklatılamaz. Bunun yerine iptal edebilirsiniz."
          }
        }
      }
    },
    "Unknown": {
      "comment": "Print job state",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbekend"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinmiyor"
          }
