    },
    "Action Failed": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actie mislukt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem Başarısız Oldu"
          }
        }
      }
    },
    "All your completed jobs for this printer and their retained documents will be permanently removed, including older jobs not shown in the list. Jobs in the queue are kept.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je voltooide taken voor deze printer en de bewaarde documenten worden definitief verwijderd, ook oudere taken die niet in de lijst staan. Taken in de wachtrij blijven staan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yazıcıdaki tüm tamamlanmış işleriniz ve saklanan belgeleri, listede görünmeyen eski işler de dahil olmak üzere kalıcı olarak silinecek. Kuyruktaki işler korunur."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "Cancel %lld Jobs?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld taken annuleren?"
          }
        },
        "tr": {
