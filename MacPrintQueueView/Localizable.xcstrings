    "Zoom to Fit": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Passend maken"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sığdır"
          }
        }
      }
    },
    "“%@” and its retained document will be permanently removed. You will no longer be able to view or reprint it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” en het bewaarde document worden definitief verwijderd. Bekijken of opnieuw afdrukken kan daarna niet meer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ve saklanan belgesi kalıcı olarak silinecek. Artık görüntüleyemez veya yeniden yazdıramazsınız."
          }
        }
      }
    },
    "“%@” is no longer completed and was not removed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is niet meer voltooid en is niet verwijderd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” artık tamamlanmış değil ve kaldırılmadı."
          }
        }
      }
    }
