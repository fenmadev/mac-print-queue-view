    },
    "Aborted": {
      "comment": "Print job state",
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgebroken"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarıda kesildi"
          }
        }
