        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te ayarlanmış yazıcı yok."
          }
        }
      }
    },
    "None of the documents in this job can be displayed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen van de documenten in deze taak kan worden weergegeven."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işteki belgelerin hiçbiri görüntülenemiyor."
