    "Larger Thumbnails": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grotere miniaturen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha Büyük Küçük Resimler"
          }
        }
      }
    },
    "Make the page thumbnails in the queue larger (⌥⌘=)": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak de paginaminiaturen in de wachtrij groter (⌥⌘=)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruktaki sayfa küçük resimlerini büyüt (⌥⌘=)"
          }
        }
      }
    },
    "Make the page thumbnails in the queue smaller (⌥⌘-)": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak de paginaminiaturen in de wachtrij kleiner (⌥⌘-)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyruktaki sayfa küçük resimlerini küçült (⌥⌘-)"
          }
        }
      }
    },
    "Move the job one place down in the queue (⌥⌘↓)": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats de taak één plaats naar achteren in de wachtrij (⌥⌘↓)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşi kuyrukta bir sıra aşağı taşı (⌥⌘↓)"
          }
        }
      }
    },
    "Move the job one place up in the queue (⌥⌘↑)": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats de taak één plaats naar voren in de wachtrij (⌥⌘↑)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşi kuyrukta bir sıra yukarı taşı (⌥⌘↑)"
          }
        }
      }
    },
    "Move the selected jobs one place down in the queue, as one block (⌥⌘↓)": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats de geselecteerde taken als één blok één plaats naar achteren in de wachtrij (⌥⌘↓)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili işleri tek blok olarak kuyrukta bir sıra aşağı taşı (⌥⌘↓)"
          }
        }
      }
    },
    "Move the selected jobs one place up in the queue, as one block (⌥⌘↑)": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats de geselecteerde taken als één blok één plaats naar voren in de wachtrij (⌥⌘↑)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili işleri tek blok olarak kuyrukta bir sıra yukarı taşı (⌥⌘↑)"
