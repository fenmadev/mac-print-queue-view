            "value": "İş %d"
          }
        }
      }
    },
    "Jobs no longer completed, and therefore not removed: %lld": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken die niet meer voltooid waren en daarom niet zijn verwijderd: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık tamamlanmış olmadığı için kaldırılmayan işler: %lld"
          }
        }
      }
    },
    "Jobs that had already started printing and were not paused: %lld": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taken die al werden afgedrukt en daarom niet zijn gepauzeerd: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdırılmaya başlandığı için duraklatılmayan işler: %lld"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taal"
          }
        },
        "tr": {
