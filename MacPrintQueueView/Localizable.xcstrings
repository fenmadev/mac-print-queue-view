    "Only %lld of the %lld images in this document can be displayed.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slechts %1$lld van de %2$lld afbeeldingen in dit document kunnen worden weergegeven."
