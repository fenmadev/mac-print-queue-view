    "%@ (default printer)": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (standaardprinter)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (varsayılan yazıcı)"
          }
        }
      }
    },
    "%lld jobs selected": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld taken geselecteerd"
          }
