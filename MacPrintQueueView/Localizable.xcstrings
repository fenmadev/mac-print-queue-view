          }
        }
      }
    },
    "No access to this job. Only the owner of the job or an administrator can view its content.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot deze taak. Alleen de eigenaar van de taak of een beheerder kan de inhoud bekijken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işe erişim yok. İçeriği yalnızca işin sahibi veya bir yönetici görüntüleyebilir."
          }
        }
      }
    },
    "No connection to the printing service": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen verbinding met de afdrukservice"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdırma hizmetiyle bağlantı yok"
          }
        }
      }
    },
    "No jobs in the queue": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen taken in de wachtrij"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuyrukta iş yok"
          }
        }
      }
    },
    "No printers are set up on this Mac.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn op deze Mac geen printers ingesteld."
